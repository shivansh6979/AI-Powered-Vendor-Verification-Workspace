# Database
DATABASE_URL="postgresql://user:password@localhost:5432/vendor_verification"

# Google Gemini API
GOOGLE_GENERATIVE_AI_API_KEY="your-google-api-key"

# GLEIF API (Global Legal Entity Identifier Foundation)
# Free API - No key required! https://lei.tools/api/v1
# GLEIF_SANDBOX_MODE enables mock responses for development
GLEIF_SANDBOX_MODE="true"

# Email Service (Resend)
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="no-reply@yourdomain.com"

# Server Configuration
PORT="5000"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"
